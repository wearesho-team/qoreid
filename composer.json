{
    "name": "wearesho-team/qoreid",
    "description": "QoreID PHP Integration SDK",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.4.5",
        "horat1us/environment-config": "^1.6",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Wearesho\\QoreId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wearesho\\QoreId\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Horat1us",
            "email": "reclamme@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "process-timeout": 1800,
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "lint": "./vendor/bin/phpcs --standard=PSR12 ./src ./tests",
        "phpcbf": "./vendor/bin/phpcbf --standard=PSR12 ./src ./tests",
        "test": "./vendor/bin/phpunit",
        "cover": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-text",
        "cover-xml": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-clover ./coverage.xml"
    }
}
